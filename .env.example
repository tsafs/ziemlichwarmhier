# S3-compatible object storage (Scaleway) — required for pipeline jobs
ACCESS_KEY=your-scaleway-access-key
SECRET_KEY=your-scaleway-secret-key
BUCKET_NAME=your-bucket-name
REGION=nl-ams
ENDPOINT_URL=https://s3.nl-ams.scw.cloud

# Copernicus Climate Data Store — required for HYRAS data fetching
CDS_API_KEY=your-cds-api-key

# Frontend (optional) — override "now" timestamp for dev/testing
# VITE_APP_NOW=2026-02-25T12:00:00
