{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "env.schema.json",
  "title": "EnvironmentVariables",
  "description": "Required environment variables for ERA5-Land pipeline (Phase 2 infra). Used by CI and env-validation skill.",
  "type": "object",
  "required": [
    "ACCESS_KEY",
    "SECRET_KEY",
    "BUCKET_NAME",
    "REGION",
    "ENDPOINT_URL",
    "CDS_API_KEY",
    "CLIMATE_DATA_PROVIDER"
  ],
  "additionalProperties": true,
  "properties": {
    "ACCESS_KEY": {
      "type": "string",
      "minLength": 1,
      "description": "Hetzner S3-compatible access key"
    },
    "SECRET_KEY": {
      "type": "string",
      "minLength": 1,
      "description": "Hetzner S3-compatible secret key"
    },
    "BUCKET_NAME": {
      "type": "string",
      "minLength": 1,
      "description": "S3 bucket for climate tiles and data"
    },
    "REGION": {
      "type": "string",
      "enum": [
        "fsn1",
        "nbg1",
        "hel1"
      ],
      "description": "Hetzner region identifier"
    },
    "ENDPOINT_URL": {
      "type": "string",
      "format": "uri",
      "description": "S3-compatible endpoint URL"
    },
    "CDS_API_KEY": {
      "type": "string",
      "pattern": "^\\d+:[a-f0-9-]+$",
      "description": "CDS API key in uid:key format"
    },
    "CLIMATE_DATA_PROVIDER": {
      "type": "string",
      "enum": [
        "era5-land"
      ],
      "description": "Climate data provider (currently only era5-land)"
    }
  }
}