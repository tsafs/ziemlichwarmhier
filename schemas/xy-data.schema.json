{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "xy-data.schema.json",
  "title": "XY Data",
  "description": "Year-indexed time series in {x, y} parallel-array format, used by all plots.",
  "type": "object",
  "required": [
    "x",
    "y"
  ],
  "additionalProperties": false,
  "properties": {
    "x": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Years (integers)"
    },
    "y": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Values (day counts, temperatures, etc.)"
    }
  }
}