# Mocked secrets for local GitHub Actions dry-runs via act
# Copy to .act-secrets and adjust if needed:
#   cp .act-secrets.example .act-secrets
#
# These are intentionally fake values for offline CI parity testing.
# Real values are only needed in GitHub Actions or for live deploys.

# S3-compatible storage (Hetzner / Scaleway)
AWS_ACCESS_KEY_ID=act-mock-access-key
AWS_SECRET_ACCESS_KEY=act-mock-secret-key
S3_ENDPOINT_URL=https://mock.s3.endpoint.local
S3_BUCKET_NAME=mock-climate-tiles

# GitHub Container Registry (auto-provided in GHA; mocked here)
GITHUB_TOKEN=act-mock-github-token

# Cloudflare (if used in future workflows)
CLOUDFLARE_API_TOKEN=act-mock-cf-token
CLOUDFLARE_ACCOUNT_ID=act-mock-cf-account
